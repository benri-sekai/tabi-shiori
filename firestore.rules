rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // 1件あたりの大きさを抑え、無料枠を食いつぶす書き込みを防ぐ
    function smallDoc() {
      return request.resource.data.size() <= 30;
    }

    function validSection(section) {
      return section in ['members', 'itinerary', 'places', 'reservations', 'expenses', 'images'];
    }
    // 画像はアプリで圧縮したJPEGだけを受け付ける
    function validImage(section) {
      return section != 'images'
        || (request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() <= 400000);
    }

    // 招待リンクの推測困難なIDを知っている人だけが開ける。旅行の一覧取得は誰にも許可しない
    match /trips/{tripId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && smallDoc();
      // メンバーは中身を1件ずつ消せるので、旅ごとの削除も同じくメンバーに任せる
      allow delete: if signedIn();

      match /{section}/{docId} {
        allow read: if signedIn() && validSection(section);
        allow create, update: if signedIn() && smallDoc() && validSection(section) && validImage(section);
        allow delete: if signedIn() && validSection(section);
      }
    }
  }
}
